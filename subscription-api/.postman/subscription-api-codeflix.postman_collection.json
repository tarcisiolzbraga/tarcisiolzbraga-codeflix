          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Preencha a variavel tokenDoEmail com o token do link que esta na fila.",
                  "if (!pm.collectionVariables.get(\"tokenDoEmail\")) {",
                  "    pm.test.skip(\"tokenDoEmail nao preenchido: pegue o link na fila do broker\", () => {});",
                  "} else {",
                  "    pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "    const corpo = pm.response.json();",
                  "    pm.test(\"o corpo tem so accountId\", () => pm.expect(Object.keys(corpo)).to.eql([\"accountId\"]));",
                  "    pm.collectionVariables.set(\"contaId\", corpo.accountId);",
                  "}"
                ]
              }
            }
          ]
        }
