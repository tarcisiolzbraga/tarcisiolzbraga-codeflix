{
  "_comment": [
    "Esta topologia está declarada em dois lugares: aqui e no AmqpConfig da infrastructure.",
    "Mudança de exchange, fila, binding ou routing key tem de ser feita nos dois, senão a",
    "aplicação sobe e falha com PRECONDITION_FAILED ao declarar algo diferente do que existe.",
    "JSON não aceita comentário, e esta chave é ignorada pelo import do RabbitMQ; não usar",
    "arguments para isso, porque ali viraria argumento de verdade e causaria justamente a",
    "divergência que o aviso previne."
  ],

  "vhosts": [ { "name": "/" } ],

  "users": [
    { "name": "__AMQP_USER__", "password": "__AMQP_PASSWORD__", "tags": [ "administrator" ] }
  ],

  "permissions": [
    { "user": "__AMQP_USER__", "vhost": "/", "configure": ".*", "write": ".*", "read": ".*" }
  ],

  "exchanges": [
    {
      "name": "video.events", "vhost": "/", "type": "direct",
      "durable": true, "auto_delete": false, "internal": false, "arguments": {}
    }
  ],

  "queues": [
    { "name": "video.created.queue", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "video.encoded.queue", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} }
  ],

  "bindings": [
    {
      "source": "video.events", "vhost": "/", "destination": "video.created.queue",
      "destination_type": "queue", "routing_key": "video.created", "arguments": {}
    },
    {
      "source": "video.events", "vhost": "/", "destination": "video.encoded.queue",
      "destination_type": "queue", "routing_key": "video.encoded", "arguments": {}
    }
  ]
}
