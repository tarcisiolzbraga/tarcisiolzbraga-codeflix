                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"sem erros\", () => pm.expect(r.errors, JSON.stringify(r.errors)).to.be.undefined);",
                  "pm.test(\"campos da paginação\", () => pm.expect(Object.keys(r.data.categories.meta).sort())",
                  "    .to.eql([\"currentPage\",\"perPage\",\"total\"]));",
                  "pm.test(\"devolve a página pedida\", () => {",
                  "    pm.expect(r.data.categories.meta.currentPage).to.eql(0);",
                  "    pm.expect(r.data.categories.meta.perPage).to.eql(10);",
                  "});",
                  "pm.test(\"acha a categoria semeada\", () => pm.expect(r.data.categories.items.map(i => i.id))",
                  "    .to.include(pm.collectionVariables.get(\"categoriaAtivaId\")));"
                ]
              }
            }
          ]
        },
