                "variables": "{\n  \"input\": {\n    \"id\": \"{{categoriaInativaId}}\",\n    \"name\": \"Categoria desativada\",\n    \"description\": \"Fora do catálogo\",\n    \"active\": false,\n    \"createdAt\": \"2026-09-30T12:00:00Z\",\n    \"updatedAt\": \"2026-10-01T08:30:00Z\"\n  }\n}"
              }
            },
            "description": "Guardar o inativo é de propósito: a replicação o mantém em dia, e o filtro é na leitura — reativar no admin o faz reaparecer aqui sem replay do Kafka."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"sem erros\", () => pm.expect(r.errors, JSON.stringify(r.errors)).to.be.undefined);",
                  "pm.test(\"a escrita aceita o inativo\", () => pm.expect(r.data.saveCategory.id)",
                  "    .to.eql(pm.collectionVariables.get(\"categoriaInativaId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lista as categorias",
