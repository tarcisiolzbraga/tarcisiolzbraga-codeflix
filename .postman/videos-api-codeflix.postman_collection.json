            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{\n  categories(search: \"\", page: 0, perPage: 10, sort: \"name\", direction: \"asc\") {\n    meta {\n      currentPage\n      perPage\n      total\n    }\n    items {\n      id\n      name\n      description\n    }\n  }\n}",
                "variables": ""
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
