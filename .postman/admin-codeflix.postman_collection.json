            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test(\"nome trocado\", () => pm.expect(c.name).to.eql(\"Filmes e séries\"));",
                  "pm.test(\"updatedAt avançou\", () => pm.expect(new Date(c.updatedAt).getTime())",
                  "    .to.be.above(new Date(c.createdAt).getTime()));"
                ]
