            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"devolve o id\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"categoriaId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confere o nome novo e o updatedAt",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{categoriaId}}"
