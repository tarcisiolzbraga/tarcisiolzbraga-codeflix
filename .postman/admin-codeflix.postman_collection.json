            }
          ]
        },
        {
          "name": "Desativa a categoria",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoriaId}}/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{categoriaId}}",
                "deactivate"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"fica inativa\", () => pm.expect(pm.response.json().active).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ativa a categoria de novo",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoriaId}}/activate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{categoriaId}}",
                "activate"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"volta a ativa\", () => pm.expect(pm.response.json().active).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Recusa categoria sem nome",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"sem nome\"\n}"
            },
            "description": "Erro de validação: a API responde 422 com a lista de erros, não 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"explica o erro do nome\", () => pm.expect(pm.response.json().errors)",
                  "    .to.include(\"'name' should not be null\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Busca id inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 404\", () => pm.response.to.have.status(404));",
