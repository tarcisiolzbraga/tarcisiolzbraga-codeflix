{
  "info": {
    "name": "admin-codeflix",
    "description": "Regressão manual da API do catálogo. Roda de cima para baixo no Collection Runner: cada pasta cria o que precisa, confere pela própria API e apaga no fim, deixando o banco como estava. Ajuste baseUrl se a API não estiver em localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "categoriaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "generoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "atorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "diretorId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Categorias",
      "item": [
        {
          "name": "Cria a categoria Filmes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Filmes\",\n  \"description\": \"Longas-metragens\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"traz o header Location\", () => pm.response.to.have.header(\"Location\"));",
                  "const id = pm.response.json().id;",
                  "pm.test(\"devolve o id\", () => pm.expect(id).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"categoriaId\", id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Busca a categoria criada",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{categoriaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test(\"conjunto exato de campos\", () => pm.expect(Object.keys(c).sort())",
                  "    .to.eql([\"active\",\"createdAt\",\"description\",\"id\",\"name\",\"updatedAt\"]));",
                  "pm.test(\"nasce ativa\", () => pm.expect(c.active).to.be.true);",
                  "pm.test(\"datas iguais ao criar\", () => pm.expect(c.createdAt).to.eql(c.updatedAt));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lista buscando por termo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories?search=Filmes&page=0&perPage=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Filmes"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "perPage",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test(\"campos da paginação\", () => pm.expect(Object.keys(p).sort())",
                  "    .to.eql([\"currentPage\",\"items\",\"perPage\",\"total\"]));",
                  "pm.test(\"acha a categoria criada\", () => pm.expect(p.items.map(i => i.id)).to.include(",
                  "    pm.collectionVariables.get(\"categoriaId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualiza a categoria",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
