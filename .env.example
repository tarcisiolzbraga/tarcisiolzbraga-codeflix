# Copie para .env e preencha. O arquivo .env não é versionado.
#
# Um arquivo só para o monorepo: o compose o lê para interpolar portas e segredos, e as duas
# aplicações o leem pelo spring.config.import (../.env), rodando de dentro da própria pasta.
#
# Variável com prefixo CATALOG_ é onde a videos-api precisava de valor diferente da admin-api — só
# as duas portas. Todo o resto é compartilhado, e é justamente isso que o repositório único resolve:
# o KEYCLOAK_HOST, por exemplo, não pode mais divergir entre os dois lados, e era a divergência dele
# que fazia o admin recusar o token do catálogo pelo `iss`.

# --- Banco da admin-api -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=adm_videos
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Opcional: tamanho do pool de conexões (padrão 5 no development, 20 nos outros perfis)
# DB_POOL_SIZE=5

# --- Armazenamento das mídias (Garage, compatível com S3) -------------------------------------
STORAGE_PORT=3900
STORAGE_BUCKET=codeflix-medias
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Segredo de RPC do Garage: 32 bytes em hexadecimal (openssl rand -hex 32)
STORAGE_RPC_SECRET=

# --- Fila do codificador de vídeo (RabbitMQ) --------------------------------------------------
AMQP_PORT=5672
AMQP_MANAGEMENT_PORT=15672
AMQP_USER=
AMQP_PASSWORD=

# Opcional: entrega dos avisos ao broker
# OUTBOX_POLL_INTERVAL=5000     # de quanto em quanto tempo o relay procura o que entregar (ms)
# OUTBOX_BATCH_SIZE=50          # quantas linhas o relay leva por vez
# OUTBOX_RETENTION=7d           # por quanto tempo a linha entregue fica guardada

# --- Replicação da admin-api para a videos-api (profile cdc) ----------------------------------
# Porta do broker para quem roda no host; dentro da rede do compose é sempre kafka:9092
KAFKA_PORT=29092
# API REST do Kafka Connect, onde o conector do Debezium é registrado
KAFKA_CONNECT_PORT=8083
# Usuário que o Debezium usa para ler o binlog do MySQL. Só é criado na criação do volume
# mysql_data; em banco que já existe, rode o SQL à mão (veja o README da admin-api).
CDC_USER=debezium
CDC_PASSWORD=
# De onde a videos-api consome, rodando no host
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- Autenticação (Keycloak), compartilhada pelos dois ----------------------------------------
# 8081 porque a 8080 é da admin-api, e a mesma porta dentro e fora do container
KEYCLOAK_PORT=8081
# O MESMO nome para os dois lados e para o Postman, senão o `iss` do token não bate com o que a
# aplicação espera. localhost serve quando as aplicações rodam no host, pela IDE ou por bootRun.
# Para rodá-las em container, troque por `keycloak` e acrescente `127.0.0.1 keycloak` ao
# /etc/hosts da sua máquina — aí o nome vale dentro e fora da rede do Docker.
KEYCLOAK_HOST=localhost
KEYCLOAK_REALM=codeflix
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
# Segredo dos clients do realm; em hexadecimal (openssl rand -hex 24)
KEYCLOAK_CLIENT_SECRET=
# A credencial da videos-api para ler a API da admin-api: as quatro roles de leitura, nenhuma de
# escrita. Não use o categories-codeflix, que existe no realm para provar o 403.
KEYCLOAK_CLIENT_ID=videos-api-codeflix

# --- admin-api --------------------------------------------------------------------------------
APP_PORT=8080
# Porta do depurador; anexe a IDE nela
APP_DEBUG_PORT=5005

# --- videos-api -------------------------------------------------------------------------------
# 8082 porque a 8080 é da admin-api e a 8081 é do Keycloak
CATALOG_APP_PORT=8082
# O Elasticsearch do catálogo, separado do que a observabilidade sobe: aquele guarda log, este
# guarda catálogo
CATALOG_ELASTIC_PORT=9201
ELASTIC_URIS=http://localhost:9201
# A API da admin-api, de onde vem o registro completo depois do aviso do CDC
ADMIN_API_BASE_URL=http://localhost:8080

# --- encoder-api ------------------------------------------------------------------------------
# Banco próprio do encoder: ele guarda a mídia recebida e cada tentativa de conversão.
ENCODER_DB_NAME=encoder
ENCODER_DB_USER=encoder
ENCODER_DB_PASSWORD=
# 5433 porque a 5432 pode já estar em uso por um Postgres da máquina
ENCODER_DB_PORT=5433
# Quantas conversões ao mesmo tempo. Cada uma ocupa um núcleo com o ffmpeg.
ENCODER_WORKERS=2

# --- Observabilidade (profile observability) --------------------------------------------------
ELASTIC_PORT=9200
KIBANA_PORT=5601
# 32 caracteres ou mais. Sem ela o Kibana desliga a API de alerting, e a regra da fila morta não
# pode ser criada. Gere a sua: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=troque-por-32-caracteres-ou-mais-aqui
