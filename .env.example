# Copie para .env e preencha. O arquivo .env não é versionado.

# Armazenamento de leitura do catálogo
ELASTIC_PORT=9201
ELASTIC_URIS=http://localhost:9201

# Broker de onde chegam as mudanças do admin-codeflix. Ele sobe no compose do admin, com
# `docker compose --profile cdc up -d`, e anuncia este endereço para quem roda no host.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# A API do admin-codeflix, de onde vem o registro completo depois do aviso do CDC
ADMIN_API_BASE_URL=http://localhost:8080

# Autenticação para falar com a API do admin. O client categories-codeflix já existe no realm dele,
# e a service account dele já tem a role CODEFLIX_CATEGORIES, que é a exigida por /categories/**.
#
# O MESMO host que o admin usa como issuer (o KEYCLOAK_HOST do .env dele), senão o token é
# recusado: o `iss` é a URL por onde o token foi pedido, e o admin só aceita a que ele espera.
#
# localhost porque em desenvolvimento as duas aplicações rodam no host, pela IDE ou por bootRun, e
# o nome `keycloak` só existe no DNS interno do Docker — a sua máquina não participa dessa rede.
# Para rodar o admin em container, lá ele só alcança o Keycloak por `keycloak:8081`: aí os dois
# .env voltam para `keycloak` e a máquina precisa da linha `127.0.0.1 keycloak` no /etc/hosts.
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=codeflix
KEYCLOAK_CLIENT_ID=categories-codeflix
# O mesmo valor do KEYCLOAK_CLIENT_SECRET do .env do admin-codeflix
KEYCLOAK_CLIENT_SECRET=

# A aplicação. 8082 porque a 8080 é a do admin-codeflix e a 8081 é a do Keycloak dele.
APP_PORT=8082
