DB_HOST=localhost
DB_PORT=3306
DB_NAME=adm_videos
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Opcional: tamanho do pool de conexões (padrão 5 no development, 20 nos outros perfis)
# DB_POOL_SIZE=5

# Armazenamento das mídias (Garage, compatível com S3)
STORAGE_PORT=3900
STORAGE_BUCKET=codeflix-medias
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Segredo de RPC do Garage: 32 bytes em hexadecimal (openssl rand -hex 32)
STORAGE_RPC_SECRET=
