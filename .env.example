DB_HOST=localhost
DB_PORT=3306
DB_NAME=adm_videos
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Opcional: tamanho do pool de conexões (padrão 5 no development, 20 nos outros perfis)
# DB_POOL_SIZE=5

# Armazenamento das mídias (Garage, compatível com S3)
STORAGE_PORT=3900
STORAGE_BUCKET=codeflix-medias
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Segredo de RPC do Garage: 32 bytes em hexadecimal (openssl rand -hex 32)
STORAGE_RPC_SECRET=

# Fila do codificador de vídeo (RabbitMQ)
AMQP_PORT=5672
AMQP_MANAGEMENT_PORT=15672
AMQP_USER=
AMQP_PASSWORD=

# Opcional: entrega dos avisos ao broker
# OUTBOX_POLL_INTERVAL=5000     # de quanto em quanto tempo o relay procura o que entregar (ms)
# OUTBOX_BATCH_SIZE=50          # quantas linhas o relay leva por vez
# OUTBOX_RETENTION=7d           # por quanto tempo a linha entregue fica guardada

# Replicação para o catálogo (sobe com: docker compose --profile cdc up -d)
# Porta do broker para quem roda no host; dentro da rede do compose é sempre kafka:9092
KAFKA_PORT=29092
# API REST do Kafka Connect, onde o conector do Debezium é registrado
KAFKA_CONNECT_PORT=8083
# Usuário que o Debezium usa para ler o binlog do MySQL. Só é criado na criação do volume
# mysql_data; em banco que já existe, rode o SQL à mão (veja o README).
CDC_USER=debezium
CDC_PASSWORD=

# A aplicação em container
APP_PORT=8080
# Porta do depurador; anexe a IDE nela
APP_DEBUG_PORT=5005

# Autenticação (Keycloak)
# 8081 porque a 8080 é da aplicação, e a mesma porta dentro e fora do container
KEYCLOAK_PORT=8081
# O MESMO nome dentro e fora do Docker, senão o `iss` do token não bate com o que a aplicação espera.
# Exige uma linha no /etc/hosts da sua máquina:  127.0.0.1 keycloak
KEYCLOAK_HOST=keycloak
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
# Segredo do client admin-codeflix; em hexadecimal (openssl rand -hex 24)
KEYCLOAK_CLIENT_SECRET=

# Observabilidade (sobe com: docker compose --profile observability up -d)
ELASTIC_PORT=9200
KIBANA_PORT=5601
