{
  "realm": "codeflix",
  "displayName": "Codeflix",
  "enabled": true,
  "sslRequired": "none",

  "roles": {
    "realm": [
      { "name": "CODEFLIX_ADMIN", "description": "Acesso a todo o catálogo" },
      { "name": "CODEFLIX_CATEGORIES", "description": "Acesso às categorias" },
      { "name": "CODEFLIX_GENRES", "description": "Acesso aos gêneros" },
      { "name": "CODEFLIX_CAST_MEMBERS", "description": "Acesso aos membros de elenco" },
      { "name": "CODEFLIX_VIDEOS", "description": "Acesso aos vídeos" },
      { "name": "CODEFLIX_SUBSCRIBER", "description": "Lê o catálogo servido pela videos-api-codeflix" },
      { "name": "CODEFLIX_ACCOUNT", "description": "Tem conta na subscription-api-codeflix e administra a própria assinatura" }
    ]
  },

  "clients": [
    {
      "clientId": "admin-codeflix",
      "name": "Administração do catálogo",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "__KEYCLOAK_CLIENT_SECRET__"
    },
    {
      "clientId": "categories-codeflix",
      "name": "Acesso restrito às categorias",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "__KEYCLOAK_CLIENT_SECRET__"
    },
    {
      "clientId": "videos-api-codeflix",
      "name": "Leitura do catálogo pela videos-api-codeflix",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "__KEYCLOAK_CLIENT_SECRET__"
    },
    {
      "clientId": "subscriber-codeflix",
      "name": "Assinante, que lê o catálogo servido pela videos-api-codeflix",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "__KEYCLOAK_CLIENT_SECRET__"
    },
    {
      "clientId": "subscription-api-codeflix",
      "name": "A subscription-api-codeflix, que administra os usuários do realm",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "__KEYCLOAK_CLIENT_SECRET__"
    },
    {
      "clientId": "front-codeflix",
      "name": "O front e as ferramentas, por onde uma PESSOA entra",
      "enabled": true,
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [ "+" ]
    }
  ],

  "users": [
    {
      "username": "service-account-admin-codeflix",
      "enabled": true,
      "serviceAccountClientId": "admin-codeflix",
      "realmRoles": [ "CODEFLIX_ADMIN" ]
    },
    {
      "username": "service-account-categories-codeflix",
      "enabled": true,
      "serviceAccountClientId": "categories-codeflix",
      "realmRoles": [ "CODEFLIX_CATEGORIES" ]
    },
    {
      "username": "service-account-videos-api-codeflix",
      "enabled": true,
      "serviceAccountClientId": "videos-api-codeflix",
      "realmRoles": [
        "CODEFLIX_CATEGORIES",
        "CODEFLIX_CAST_MEMBERS",
        "CODEFLIX_GENRES",
        "CODEFLIX_VIDEOS"
      ]
    },
    {
      "username": "service-account-subscriber-codeflix",
      "enabled": true,
      "serviceAccountClientId": "subscriber-codeflix",
      "realmRoles": [
        "CODEFLIX_SUBSCRIBER"
      ]
    },
    {
      "username": "service-account-subscription-api-codeflix",
      "enabled": true,
      "serviceAccountClientId": "subscription-api-codeflix",
      "clientRoles": {
        "realm-management": [ "manage-users", "view-users" ]
      }
    }
  ],

  "groups": [
    {
      "name": "subscribers",
      "path": "/subscribers",
      "realmRoles": [ "CODEFLIX_SUBSCRIBER" ]
    },
    {
      "name": "accounts",
      "path": "/accounts",
      "realmRoles": [ "CODEFLIX_ACCOUNT" ]
    }
  ]
}
